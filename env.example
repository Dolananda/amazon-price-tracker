MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=amazon_price_tracker

TRACKER_EMAIL=your-gmail@gmail.com
TRACKER_EMAIL_PASSWORD=your-16-char-app-password
TRACKER_RECEIVER_EMAIL=your-gmail@gmail.com

# How often (in hours) the background scheduler auto-checks every product
CHECK_INTERVAL_HOURS=6

# Optional: Telegram notifications alongside email (leave blank to disable)
TELEGRAM_BOT_TOKEN=
